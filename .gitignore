/.idea/
/precheck_results/
*/tmp
*/*/tmp
*.hex*
# Exception: boot.hex and boot_rom.hex are contest firmware deliverables
# (built from fw/main.c via riscv64-unknown-elf-gcc; boot.hex is the
# byte-addressed Verilog hex emitted by `objcopy -O verilog`; boot_rom.hex
# is the flat 32-bit word array form for $readmemh into a local boot ROM
# array such as rv_core_ibex_tlul.boot_rom). Both are built by the
# default `make -C fw` target and are loaded by simulation, FPGA bring-up,
# and the hardened ASIC ROM initialization.
!boot.hex
!boot_rom.hex
# Exception: busread.hex is the static RV32I test program loaded by the
# bus walk integration test under tb/cocotb/buswalk/. It is checked into
# the repo so the test runs out of the box in CI without a riscv-gcc
# build step.
!busread.hex
*.lst
*.vcd
*.gtkw
/env
/venv
/venv-cocotb
/caravel
/dependencies
/mgmt_core_wrapper
/logs
openlane2-venv
design_info.yaml
# Verilator build outputs (verilog/tb/obj_dir/) — generated by `make -C verilog/tb`,
# regenerated on every build, contain ~36 MB of compiled .o / .gch / archives.
obj_dir/

# Vendored IPs (produced by: vyges-soc-generator vendor-ips <spec>)
local-ips/

# sv2v intermediate output (produced by: scripts/sv2v_asic.sh)
build/

# Graphviz intermediate source (PNG + SVG renderings are published, not .dot)
docs/*.dot
pcba/asic/.history/

# Auxiliary scripts/ — only run_cocotb_test.sh is used by CI
scripts/*
!scripts/run_cocotb_test.sh
