# Verilator-specific flags. The sv2v-converted soc_conv.v has the usual
# crop of harmless lint warnings (width casts, ascending bit ranges in
# imported OpenTitan code, etc.) — turn them off so real diagnostics are
# not lost in the noise.
EXTRA_ARGS += -O3 -Wno-fatal \
              -Wno-WIDTH -Wno-UNOPTFLAT -Wno-UNUSED \
              -Wno-LATCH -Wno-CASEINCOMPLETE -Wno-INITIALDLY \
              -Wno-CMPCONST -Wno-MULTIDRIVEN -Wno-COMBDLY \
              -Wno-SELRANGE -Wno-WIDTHCONCAT \
              -Wno-TIMESCALEMOD -Wno-ASCRANGE -Wno-PINMISSING \
              -Wno-IMPLICIT -Wno-STMTDLY -Wno-BLKANDNBLK \
              -Wno-UNSIGNED -Wno-CASEOVERLAP -Wno-PROCASSWIRE \
              -Wno-VARHIDDEN -Wno-WIDTHTRUNC -Wno-WIDTHEXPAND

ifeq ($(WAVES),vcd)
    EXTRA_ARGS += --trace
endif
ifeq ($(WAVES),fst)
    EXTRA_ARGS += --trace-fst
endif

# ── GLS target dispatch (see tb/cocotb/smoke/Makefile for details) ───────
ifneq (,$(filter gls,$(MAKECMDGOALS)))
