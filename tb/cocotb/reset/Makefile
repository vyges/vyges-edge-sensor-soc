# edge_sensor — reset propagation test (cocotb + Verilator)
#
# Pulses rst_ni at multiple points during firmware execution and verifies
# that the CPU resets cleanly each time and resumes from a clean state.
#
# Usage:
#   make                # RTL run (default)            — verilog/rtl/
#   make gls            # generic synthesis-level GLS  — verilog/gl/
#   make gls-openlane   # OpenLane Caravel GLS         — multi-macro
#   make WAVES=fst      # FST waveform format
#   make WAVES=         # disable wave dumping
#   make clean          # wipe sim_build/
#
# See tb/cocotb/smoke/Makefile for the full GLS prerequisites notes.

