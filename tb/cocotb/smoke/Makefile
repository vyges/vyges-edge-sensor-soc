# @generated by vyges-soc-generator — do not hand-edit
#
# edge_sensor — boot smoke test (cocotb + Verilator)
#
# Boots the edge_sensor CPU from boot.hex and verifies forward progress.
# Verilator is the only supported backend (Vyges convention — production-
# quality simulator with strong CI / coverage / FST tracing support).
#
# Usage:
#   make                        # RTL run (default)            — verilog/rtl/
#   make gls                    # generic synthesis-level GLS  — verilog/gl/
#   make gls-openlane           # OpenLane Caravel GLS         — multi-macro
#   make WAVES=fst              # FST waveform format
#   make clean                  # wipe sim_build/
#
# Prerequisites:
#   verilator   (apt: verilator,   brew: verilator)
#   cocotb      (pip: cocotb >= 1.9)
#   python3
#
# Verilator + cocotb is the production-quality combination for Vyges
# verification. Other backends (iverilog, VCS, Xcelium) are intentionally
# not wired up here.
#
# GLS prerequisites
# -----------------
# `make gls` requires verilog/gl/ to contain a flat post-synthesis netlist
# with the SAME top module name as the RTL. The current soc-generator
# emits the SoC top with (* keep *) (* dont_touch *) attributes on
# boot_rom and instr_addr — required for the test wrapper's hierarchical
# $readmemh and PC monitoring to survive synthesis. If you re-harden an
# older design without these attributes, the GLS run will fail at
# elaboration with "cannot find boot_rom".
#
# `make gls-openlane` is for SoCs that target the Caravel chipIgnite
# shuttle. It instantiates user_project_wrapper instead of the flat SoC
# top, includes per-sub-macro hardened netlists, and pulls in sky130
# cell models from the PDK install. Configure via env vars:
#   PDK_ROOT       (default: ~/.ciel/ciel)
#   GL_DIR         (default: ../../../verilog/gl)
#   SDF_DIR        (default: ../../../sdf — empty SDF set is OK)

SIM             := verilator
TOPLEVEL_LANG   := verilog
TOPLEVEL        := tb_smoke
MODULE          := test_smoke

# Waveform format — VCD by default (universal, opens in gtkwave / surfer /
# scopy without conversion). Override with WAVES=fst for the more compact
# (~5x smaller) FST format if you need to ship long traces.
WAVES           ?= vcd

# ── Source lists per simulation mode ──────────────────────────────────────
# RTL_SOURCES — soc-generator output (sv2v-converted) + SRAM sim model + tb
# GLS_SOURCES — generic flat post-synthesis netlist with the same top
# GLS_OL_SOURCES — Caravel multi-macro hardened netlists + sky130 cell models

RTL_SOURCES := $(PWD)/../../../verilog/rtl/soc_conv.v \
  $(PWD)/../sim_models/CF_SRAM_1024x32.v \
  $(PWD)/tb_smoke.sv

GL_DIR      ?= ../../../verilog/gl
GLS_SOURCES := \
  $(GL_DIR)/edge_sensor_soc_top.v \
  $(PWD)/../sim_models/CF_SRAM_1024x32.v \
  $(PWD)/tb_smoke.sv

# OpenLane Caravel GLS — uses the multi-macro user_project_wrapper plus
# per-sub-macro hardened netlists. The exact macro list is hardcoded here
# for now (matching the soc-generator's standard ASIC ASIC hardening
# pipeline output) — a future revision will derive this from the spec.
PDK_ROOT     ?= $(HOME)/.ciel/ciel
SKY130_LIB   ?= $(shell ls -d $(PDK_ROOT)/sky130/versions/*/sky130A/libs.ref/sky130_fd_sc_hd/verilog 2>/dev/null | head -1)
SDF_DIR      ?= ../../../sdf

GLS_OL_SOURCES := \
  $(SKY130_LIB)/sky130_fd_sc_hd.v \
  $(SKY130_LIB)/primitives.v \
  $(GL_DIR)/user_project_wrapper.v \
  $(GL_DIR)/rv_core_ibex_tlul.v \
  $(GL_DIR)/uart.v \
  $(GL_DIR)/spi_host_lite.v \
  $(GL_DIR)/rv_plic_lite.v \
  $(GL_DIR)/fft_ctrl_tlul.v \
  $(GL_DIR)/xbar_main.v \
  $(GL_DIR)/edge_sensor_glue.v \
  $(PWD)/../sim_models/CF_SRAM_1024x32.v \
  $(PWD)/tb_smoke.sv

# Default = RTL; gls / gls-openlane targets override below.
VERILOG_SOURCES := $(RTL_SOURCES)

# Verilator-specific flags. The sv2v-converted soc_conv.v has the usual
# crop of harmless lint warnings (width casts, ascending bit ranges in
# imported OpenTitan code, etc.) — turn them off so the actual signal
# (real bugs) is not lost in the noise.
EXTRA_ARGS += -O3 -Wno-fatal \
              -Wno-WIDTH -Wno-UNOPTFLAT -Wno-UNUSED \
              -Wno-LATCH -Wno-CASEINCOMPLETE -Wno-INITIALDLY \
              -Wno-CMPCONST -Wno-MULTIDRIVEN -Wno-COMBDLY \
              -Wno-SELRANGE -Wno-WIDTHCONCAT \
              -Wno-TIMESCALEMOD -Wno-ASCRANGE -Wno-PINMISSING \
              -Wno-IMPLICIT -Wno-STMTDLY -Wno-BLKANDNBLK \
              -Wno-UNSIGNED -Wno-CASEOVERLAP -Wno-PROCASSWIRE \
              -Wno-VARHIDDEN -Wno-WIDTHTRUNC -Wno-WIDTHEXPAND

ifeq ($(WAVES),vcd)
    EXTRA_ARGS += --trace
endif
ifeq ($(WAVES),fst)
    EXTRA_ARGS += --trace-fst
endif

# ── GLS target dispatch ──────────────────────────────────────────────────
# `make gls` and `make gls-openlane` override VERILOG_SOURCES and add the
# appropriate +define+ flags before falling through to the standard cocotb
# Makefile.sim include. Both reuse the same test_smoke.py and tb_smoke.sv —
# the wrapper has an `ifndef GLS_CARAVEL` block that swaps between the
# RTL DUT instantiation and the Caravel user_project_wrapper.

ifneq (,$(filter gls,$(MAKECMDGOALS)))
    VERILOG_SOURCES := $(GLS_SOURCES)
endif

ifneq (,$(filter gls-openlane,$(MAKECMDGOALS)))
    VERILOG_SOURCES := $(GLS_OL_SOURCES)
    EXTRA_ARGS      += +define+GLS_CARAVEL +define+FUNCTIONAL +define+UNIT_DELAY=\#1
endif

.PHONY: gls gls-openlane
gls: sim
gls-openlane: sim

# Standard cocotb integration
include $(shell cocotb-config --makefiles)/Makefile.sim

clean::
	rm -rf sim_build __pycache__ results.xml dump.fst dump.vcd